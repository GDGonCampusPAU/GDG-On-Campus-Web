{
  "name": "gdg-on-campus-pau",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "frontend/hackaton"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm ci",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace backend",
    "dev:panel": "npm run dev --workspace gdg-pau-panel",
    "dev:hackaton": "npm run dev --workspace gdg-pau-hackathon",
    "test": "npm test --workspaces",
    "test:roadmap": "npm run test:roadmap --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspace gdg-pau-panel --workspace gdg-pau-hackathon",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "setup:browser": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
