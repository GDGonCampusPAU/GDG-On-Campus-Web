{
  "name": "gdg-on-campus-pau",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "frontend/hackaton"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "setup": "npm ci",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace backend",
    "dev:panel": "npm run dev --workspace frontend",
    "dev:hackaton": "npm run dev --workspace frontend/hackaton",
    "test": "npm test --workspaces",
    "test:roadmap": "npm run test:roadmap --workspaces",
    "lint": "npm run lint --workspaces",
    "build": "npm run build --workspace frontend --workspace frontend/hackaton",
    "check": "npm run lint && npm test && npm run build",
    "test:e2e": "playwright test",
    "setup:browser": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
