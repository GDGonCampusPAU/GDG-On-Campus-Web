# İsteğe bağlı Docker Compose ayarları: kökte .env olarak kullanın.
# Backend sırları backend/.env içinde kalır; buraya kopyalamayın.
API_PORT=5000
PANEL_PORT=5174
HACKATON_PORT=5173
MONGO_PORT=27017
# Portlar değişince varsayılan API URL ve CORS listesi otomatik uyarlanır.
# Tarayıcı farklı bir hostname kullanıyorsa aşağıdaki değerleri tanımlayın.
# PUBLIC_API_URL=http://localhost:5000
# CLIENT_URLS=http://localhost:5173,http://localhost:5174
# UPLOADS_PATH=./backend/uploads
