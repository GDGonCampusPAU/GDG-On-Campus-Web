# ==========================================
# Environment & Secrets (Root Protection)
# ==========================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
!backend/.env.example

# Certificates & Private Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.pkcs12
*.cer
id_rsa*
*.pub

# ==========================================
# Dependencies
# ==========================================
node_modules/
*/node_modules/
jspm_packages/

# ==========================================
# Uploads
# ==========================================
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# ==========================================
# Logs & Process IDs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Local Databases & Dumps
# ==========================================
db/
*.sqlite
*.sqlite3
*.db
*.dump
mongo-dump/
mongodump/

# ==========================================
# Test Coverage & Diagnostics
# ==========================================
coverage/
*.lcov
.nyc_output/

# ==========================================
# Build & Distribution Artifacts
# ==========================================
dist/
build/
.cache/
out/
tmp/
temp/

# ==========================================
# OS & IDE Files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
