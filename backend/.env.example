PORT=5000

# ==============================================================================
# Veritabanı (MongoDB Replica Set)
# ==============================================================================
# Form yanıtları ve kota yönetimi ACID transaction desteği gerektirir.
# Bu nedenle MongoDB bağlantısında 'replicaSet' parametresi ZORUNLUDUR.
#
# Yerel geliştirme için:
#   MONGO_URI=mongodb://localhost:27017/gdg_pau?replicaSet=rs0
# Docker / Production için:
#   MONGO_URI=mongodb://mongo:27017/gdg?replicaSet=rs0
#
# Standalone MongoDB'de replica set başlatmak için:
#   1. mongod --replSet rs0 --bind_ip_all
#   2. mongosh ile bağlanıp: rs.initiate({_id:"rs0",members:[{_id:0,host:"localhost:27017"}]})
#   (Docker Compose kullanılıyorsa compose.yaml / compose.prod.yaml bunu otomatik yapar)
MONGO_URI=mongodb://localhost:27017/gdg_pau?replicaSet=rs0

# ==============================================================================
# JWT ve Oturum Güvenliği
# ==============================================================================
# Ekip JWT Gizli Anahtarı (en az 32 karakter; örn. openssl rand -hex 32 ile üretin)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
# Ekip token geçerlilik süresi (ör: 30m, 8h, 7d)
JWT_EXPIRES_IN=7d

# Katılımcı JWT Gizli Anahtarı (ekip anahtarından bağımsız, en az 32 karakter)
# Boş bırakılırsa fallback olarak JWT_SECRET kullanılır; prod için ayrı anahtar önerilir.
PARTICIPANT_JWT_SECRET=your_participant_jwt_secret_at_least_32_chars
PARTICIPANT_JWT_EXPIRES_IN=1h
PARTICIPANT_OTP_TTL_MINUTES=10
PARTICIPANT_OTP_COOLDOWN_SECONDS=60
PARTICIPANT_OTP_MAX_ATTEMPTS=5

# ==============================================================================
# Google OAuth Doğrulaması
# ==============================================================================
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Tip: "Web application". Client Secret sunucu tarafında gerekmez, sadece Client ID gereklidir.
# ÖNEMLİ: Google Cloud Console'da "Authorized JavaScript origins" altına frontend adreslerinin
# (örn. http://localhost:5173 veya https://hackathon.pau.edu.tr) eksiksiz eklenmesi şarttır.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==============================================================================
# CORS ve İstemci Adresleri (Multi-Origin / Production Domain)
# ==============================================================================
# İzin verilen istemci adresleri virgülle ayrılarak yazılabilir (CLIENT_URLS veya CLIENT_URL).
# Yerel ortamda: http://localhost:5173,http://localhost:5174
# Canlı/Production ortamda: https://hackathon.pau.edu.tr,https://gdg.pau.edu.tr,https://admin.pau.edu.tr
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# Alternatif tekil tanım (geriye dönük uyumluluk):
# CLIENT_URL=https://hackathon.pau.edu.tr

# Çalışma modu ('development' veya 'production')
NODE_ENV=development

# Reverse Proxy arkasında çalışıyorsa proxy hop sayısı (örn. Nginx arkasında 1)
TRUST_PROXY_HOPS=0

# ==============================================================================
# Brevo (Sendinblue) E-posta ve OTP Yapılandırması
# ==============================================================================
# Canlı ortamda e-posta gönderimi için Brevo SMTP/Transactional API anahtarı zorunludur.
# NODE_ENV=production modunda simüle edilmiş konsol e-postası devre dışıdır ve API hatası üretir.
# E-posta teslimatı için Brevo panelinde gönderici domain SPF ve DKIM kayıtları doğrulanmalıdır.
# Brevo panelinden: SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@pau.edu.tr
BREVO_SENDER_NAME=GDG On Campus Pamukkale University

# ==============================================================================
# Modül ve Özellik Bayrakları (Feature Flags)
# ==============================================================================
# Hackathon bittiğinde veya devre dışı bırakılmak istendiğinde 'false' yapılabilir:
ENABLE_HACKATHON_MODULE=true

# ==============================================================================
# Seed İlk Yönetici Bilgileri (seed.js için)
# ==============================================================================
# seedAdminService gereksinimleri:
# - Şifre EN AZ 12 KARAKTER olmalı, büyük harf, küçük harf, rakam ve sembol içermelidir.
# - 'Admin123456!' varsayılan şifresi seedAdminService tarafından GÜVENLİK GEREĞİ REDDEDİLİR.
DEFAULT_ADMIN_NAME=GDG Admin
DEFAULT_ADMIN_EMAIL=admin@pau.edu.tr
DEFAULT_ADMIN_PASSWORD=P@u_Gdg#2026!AdminSec
