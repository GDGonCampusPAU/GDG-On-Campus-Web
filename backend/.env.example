PORT=5000
MONGO_URI=mongodb://localhost:27017/gdg_pau
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Brevo (Sendinblue) Email & 2FA / OTP Configuration
# Brevo panelinden (SMTP & API -> API Keys) alacağınız anahtarı buraya yazın:
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@pau.edu.tr
BREVO_SENDER_NAME=GDG On Campus Pamukkale University

# Feature Flags / Modules
# Hackathon bittiğinde false yaparak modülü tek tıkla gizleyebilir / kapatabilirsiniz:
ENABLE_HACKATHON_MODULE=true

# Seed Admin Credentials (Optional override for seed.js)
DEFAULT_ADMIN_NAME=GDG Admin
DEFAULT_ADMIN_EMAIL=admin@pau.edu.tr
DEFAULT_ADMIN_PASSWORD=Admin123456!
