{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": false,
    "maxNodeModuleJsDepth": 0,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts"
  ]
}
