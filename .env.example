# GDG On Campus Pamukkale University - Environment Configuration Reference
# Kopyalayarak yerel ortam için .env veya backend/.env oluşturabilirsiniz.

# ==============================================================================
# Veritabanı (MongoDB Replica Set)
# ==============================================================================
# Form yanıtı ve kota yönetimi ACID transaction desteği gerektirir.
# Yerel geliştirme:
MONGO_URI=mongodb://localhost:27017/gdg_pau?replicaSet=rs0
# Docker / Production:
# MONGO_URI=mongodb://mongo:27017/gdg?replicaSet=rs0
#
# Standalone MongoDB replica set kurulumu:
# 1. mongod --replSet rs0 --bind_ip_all
# 2. mongosh: rs.initiate({_id:"rs0",members:[{_id:0,host:"localhost:27017"}]})
# (Docker Compose ile çalıştırıldığında replica set otomatik yapılandırılır)

# ==============================================================================
# API ve Sunucu Port / Adres Ayarları
# ==============================================================================
PORT=5000
NODE_ENV=development
TRUST_PROXY_HOPS=0

# ==============================================================================
# JWT Gizli Anahtarları (En az 32 karakter)
# ==============================================================================
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
PARTICIPANT_JWT_SECRET=super_secret_participant_jwt_key_at_least_32_characters
PARTICIPANT_JWT_EXPIRES_IN=1h
PARTICIPANT_OTP_TTL_MINUTES=10
PARTICIPANT_OTP_COOLDOWN_SECONDS=60
PARTICIPANT_OTP_MAX_ATTEMPTS=5

# ==============================================================================
# CORS ve İstemci Adresleri (Multi-Origin / Production Domain)
# ==============================================================================
# Çoklu origin desteği için virgülle ayrılmış adresler:
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# Production örneği:
# CLIENT_URLS=https://gdgocpamukkale.com,https://www.gdgocpamukkale.com,https://panel.gdgocpamukkale.com

# ==============================================================================
# Google OAuth Yapılandırması
# ==============================================================================
# Google Cloud Console Web Application Client ID (secret gerekmez)
# Authorized JavaScript Origins: frontends (örn. http://localhost:5173 veya https://gdgocpamukkale.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==============================================================================
# Brevo (Sendinblue) E-posta Servisi
# ==============================================================================
# Canlı ortamda gerçek teslimat için Brevo API anahtarı zorunludur ('Transactional email: All').
# SPF ve DKIM doğrulanmış domain adresi kullanılmalıdır; Reply-To için kulüp Gmail'i verilebilir.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@gdgocpamukkale.com
BREVO_SENDER_NAME=GDG On Campus Pamukkale University
BREVO_REPLY_TO=gdgocpau@gmail.com
# Opsiyonel: Başvuru onay/red mailleri için ayrı sender / replyTo seçmek isterseniz:
# BREVO_APPLICATION_SENDER_EMAIL=noreply@gdgocpamukkale.com
# BREVO_APPLICATION_SENDER_NAME=GDG On Campus PAU Hackathon
# BREVO_APPLICATION_REPLY_TO=gdgocpau@gmail.com

# ==============================================================================
# Seed İlk Yönetici Bilgileri (seed.js)
# ==============================================================================
# seedAdminService gereksinimleri:
# - Şifre EN AZ 12 KARAKTER olmalı, büyük/küçük harf, rakam ve sembol içermelidir.
# - 'Admin123456!' varsayılan şifresi GÜVENLİK GEREĞİ KESİNLİKLE REDDEDİLİR.
DEFAULT_ADMIN_NAME=GDG Admin
DEFAULT_ADMIN_EMAIL=admin@pau.edu.tr
DEFAULT_ADMIN_PASSWORD=P@u_Gdg#2026!AdminSec

# ==============================================================================
# Modül Bayrakları
# ==============================================================================
ENABLE_HACKATHON_MODULE=true
