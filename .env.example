# ==============================================================================
# Kök .env — YALNIZCA Docker Compose değişkenleri (compose.yaml / compose.prod.yaml)
# ==============================================================================
# Kullanım: cp .env.example .env   (isteğe bağlı; tüm değerlerin varsayılanı vardır)
#
# Backend ayarları ve sırları (JWT_SECRET, BREVO_API_KEY, MONGO_URI, admin şifresi ...) burada DEĞİL,
# backend/.env içinde tutulur:   cp backend/.env.example backend/.env
# Üretimde CLIENT_URLS de backend/.env içindedir; tanımlı değilse backend başlamaz.
# Ön yüz ayarları: frontend/.env ve frontend/hackaton/.env (ilgili .env.example dosyaları).

# --- Geliştirme: docker compose up (compose.yaml) ---
API_PORT=5000
PANEL_PORT=5174
HACKATON_PORT=5173
MONGO_PORT=27017
# Portlar değişince varsayılan API URL ve CORS listesi otomatik uyarlanır.
# Tarayıcı farklı bir hostname kullanıyorsa aşağıdaki değerleri tanımlayın.
# PUBLIC_API_URL=http://localhost:5000
# CLIENT_URLS=http://localhost:5173,http://localhost:5174
# UPLOADS_PATH=./backend/uploads

# --- Üretim: docker compose -f compose.prod.yaml up -d --build ---
# HTTPS 443'te sabittir; sertifika nginx/certs/origin.pem + origin.key olarak konur
# (Cloudflare Origin Certificate; bkz. docs/CANLIYA_CIKIS_KONTROL_LISTESI.md). Sertifika yoksa nginx başlamaz.
# WEB_PORT=80
# WEB_PANEL_PORT=8080
# Proxy hop sayısı: Nginx arkasında 1. Cloudflare + Nginx için de 1: nginx gerçek IP'yi
# CF-Connecting-IP'den alır (yalnız Cloudflare IP aralıklarına güvenerek).
# TRUST_PROXY_HOPS=1
#
# Ön yüz derleme değişkenleri: build sırasında bundle'a gömülür; değişince --build gerekir.
# Boş API URL = aynı origin (/api/v1, nginx üzerinden).
# VITE_API_URL=
# Google ile giriş butonu için; backend/.env içindeki GOOGLE_CLIENT_ID ile aynı olmalı.
# VITE_GOOGLE_CLIENT_ID=
