# ==============================================================================
# Kök .env — YALNIZCA Docker Compose değişkenleri (compose.yaml / compose.prod.yaml)
# ==============================================================================
# Kullanım: cp .env.example .env   (isteğe bağlı; tüm değerlerin varsayılanı vardır)
#
# Backend ayarları ve sırları (JWT_SECRET, BREVO_API_KEY, MONGO_URI ...) burada DEĞİL,
# backend/.env içinde tutulur:   cp backend/.env.example backend/.env
# Ön yüz ayarları: frontend/.env ve frontend/hackaton/.env (ilgili .env.example dosyaları).

# --- Geliştirme (compose.yaml) ---
API_PORT=5000
PANEL_PORT=5174
HACKATON_PORT=5173
MONGO_PORT=27017
# Portlar değişince varsayılan API URL ve CORS listesi otomatik uyarlanır.
# Tarayıcı farklı bir hostname kullanıyorsa aşağıdaki değerleri tanımlayın.
# PUBLIC_API_URL=http://localhost:5000
# UPLOADS_PATH=./backend/uploads

# --- Üretim (compose.prod.yaml) ---
# Nginx portları: hackathon sitesi WEB_PORT, panel PANEL_PORT (üretimde 8080 kullanın).
# WEB_PORT=80
# PANEL_PORT=8080
#
# DİKKAT: Aşağıdaki iki değer compose.prod.yaml içinde backend'e doğrudan verilir ve
# backend/.env içindeki aynı adlı değerleri EZER. Üretimde burada tanımlayın.
# CLIENT_URLS=https://hackathon.example.com,https://panel.example.com
# Proxy hop sayısı: Nginx arkasında 1, Cloudflare + Nginx arkasında 2.
# TRUST_PROXY_HOPS=1
